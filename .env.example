# Salin ke .env.local (lokal) atau isi di Vercel: Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-proyek>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Hanya sisi server. JANGAN beri awalan NEXT_PUBLIC. Kunci ini melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Dipakai oleh `npm run seed:admin` saja. Jangan commit nilai aslinya.
# Kunci rahasia untuk kolektor yang mengirim hasil ke /api/riset/<id>/hasil (acak, panjang).
INGEST_API_KEY=<kunci acak>

ADMIN_EMAIL=<email superadmin>
ADMIN_INITIAL_PASSWORD=<password awal; wajib diganti saat login pertama>
